# Database settings are read from the PHP process environment by components/connect.php.
# This file is a template; PHP does not load .env files automatically.
APP_ENV=development
SHOP_DB_HOST=localhost
SHOP_DB_PORT=3306
SHOP_DB_NAME=shop_db
SHOP_DB_USER=root
SHOP_DB_PASS=

# SMTP examples. Apply these values in components/smtp_config.php; mailer.php reads that PHP file.
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_PORT=587
SMTP_SECURE=tls
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=Solar Store

# Solar Assistant AI. Keep this only in the web-server environment, never in browser code.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EASYPAISA_STORE_ID=
EASYPAISA_WEBHOOK_SECRET=
EASYPAISA_REQUIRE_WEBHOOK_SIGNATURE=1
APP_BASE_URL=http://127.0.0.1:8012
